mainmenu "Entelea P4 touch identification diagnostic"

source "Kconfig.zephyr"

config TS_P4_BOOT_TRACE
	bool "Trace early P4 Simple Boot stages"
	depends on SOC_ESP32P4 && ESP_SIMPLE_BOOT
	help
	  Collect ROM-console breadcrumbs and retained clock checkpoints.
	  Diagnostic only: this changes startup timing, not watchdog configuration.

config TS_P4_BOOT_TRACE_DETAILS
	bool "Trace calls inside the P4 boot clock setup"
	depends on TS_P4_BOOT_TRACE
	help
	  Extra UART output can hide timing-sensitive faults. Keep this disabled
	  when collecting clock checkpoints or testing startup reliability.

config TS_P4_BOOT_SOFT_RESETS
	bool "Run five bounded CPU software resets after successful identification"
	depends on TS_P4_BOOT_TRACE
	help
	  Diagnostic only. Abort on unexpected reset causes, including watchdog
	  resets. Does not disable or feed watchdogs. Leaves the board idle when done.
