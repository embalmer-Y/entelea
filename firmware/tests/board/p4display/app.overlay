#include <zephyr/dt-bindings/display/panel.h>

/ {
	chosen {
		zephyr,display = &dsi_display;
	};
};

&ldo {
	status = "okay";
};

&ldo1 {
	status = "disabled";
};

&ldo2 {
	regulator-init-microvolt = <1800000>;
	regulator-boot-on;
	regulator-always-on;
};

&ldo3 {
	regulator-init-microvolt = <2500000>;
	regulator-boot-on;
};

&ldo4 {
	status = "disabled";
};

&mipi_dsi {
	status = "okay";
	data-lanes = <1>;
	phy-clock = <320000000>;
	dpi-clock-frequency = <8000000>;
};

&dsi_display {
	status = "okay";
	width = <460>;
	height = <460>;
	pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
};
