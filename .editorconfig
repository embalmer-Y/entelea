root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.py]
indent_style = space
indent_size = 4

# Patch bytes are pinned by SHA-256 (build-support/dependencies.json) and
# some context lines are a single space: editors must not trim them.
[*.patch]
trim_trailing_whitespace = false
