+			tx->in_flight = 0U;
+		} else if (tx->in_flight == 2U && eof == (intptr_t)tx->tail_prev) {
+			tx->in_flight = 1U;
+		} else if (tx->in_flight > 0U &&
+			   !dma_esp32_desc_in_list(tx, (esp_dma_desc_t *)eof)) {
