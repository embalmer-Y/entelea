+			tx->restart_pending = false;
+			gdma_hal_append(&data->hal, tx->channel_id, GDMA_CHANNEL_DIRECTION_TX);
+		}
 		k_spin_unlock(&data->lock, key);
 	}
 	if (tx->cb) {
