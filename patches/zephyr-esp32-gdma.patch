 				 GDMA_LL_EVENT_TX_EOF);
 
-		tx->cb(dev, tx->user_data, tx->channel_id * 2 + 1, -intr_status);
+		if (intr_status != 0U || completed) {
+			tx->cb(dev, tx->user_data, tx->channel_id * 2 + 1, -intr_status);
+		}
 	}
 }
 
