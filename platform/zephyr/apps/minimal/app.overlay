 *
 * r14 estop 绑定（owner 裁决 GPIO20=J4-31；机制与物理沿翻译见
 * drivers.c 注释）+ r16 板级 flash 布局（storage 1MB@0x120000——
 * D12 红线断言逼出 RAM 镜像数组债后切 flash 后端）。
 */
/ {
	zephyr,user {
		estop-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&slot0_partition {
	reg = <0x00020000 0x00100000>;
};

&storage_partition {
	reg = <0x00120000 0x00100000>;
};
