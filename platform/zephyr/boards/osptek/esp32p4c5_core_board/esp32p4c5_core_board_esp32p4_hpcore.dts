/*
 * Copyright (c) 2026 Tessera Project
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Osptek ESP32-P4C5 module on the Osptek ESP32P4 base carrier (HP core) —
 * ESP32-P4 + ESP32-C5 companion.
 * Adapted from in-tree waveshare/esp32p4_wifi6_dev_kit (same P4 SoC family).
 *
 * Vendor material this definition was checked against (2026-11-24):
 *   - gitee.com/osptek/esp32-p4c5-core-board: 88-pin table
 *     (pages/引脚定义.md), module Altium symbol library, PCB library, 3D model.
 *   - gitee.com/osptek/devboard-esp32p4c5_module: carrier schematic
 *     docs/ESP32-P4C5-Module_Schematic_V1.5.pdf (Ver 1.5, 2026-08-29,
 *     sheet "ESP32P4模组基础底板"), PoE-Ethernet adapter schematic V1.2,
 *     and the prebuilt C5 firmware ESP32-C5_ESP-Hosted_v2.12.9 (flash 0x0).
 *   The module's own schematic is not published (the core-board user guide
 *   says "5. 原理图 暂无"), so the module pin table is the pin source.
 *
 * Board facts: 16MB NOR flash, 32MB embedded PSRAM, CH343 USB-UART bridge on
 * UART0 (GPIO37 TXD / GPIO38 RXD), ESP32-P4 rev v3.2 (the Zephyr SoC
 * revision selected by Kconfig.esp32p4c5_core_board is REV_3_1). No on-board
 * LED/buttons: the carrier's LEDs belong to the display FPC and BOOT/RST are
 * the CH343's auto-download circuits, not mechanical switches.
 *
 * C5 companion wiring (vendor c5-p4-connection.png + carrier schematic):
 * SDIO pads P4 GPIO14/15/16/17/18/19 = D0/D1/D2/D3/CLK/CMD, reset P4 GPIO54 ->
 * C5 CHIP_PU (= &gpio1 22 in the gpio1 controller 32-base numbering),
 * handshake P4 GPIO6 <-> C5 GPIO2 (not modeled by the current
 * esp_hosted_mcu binding). Enabled: C5 runs an esp-hosted 3.x slave
 * firmware (owner-confirmed 2026-10-30) matching the driver contract — note
 * the vendor's prebuilt C5 binary is classic ESP-Hosted v2.12.9, which is a
 * different firmware line and must not be flashed over the MCU build.
 * Required pinned-driver patches are listed in build-support/README.md and
 * build-support/dependencies.json; network validation boundaries are in
 * docs/rf1-validation.md. Enumeration alone does not establish scan,
 * association, DHCP or TLS acceptance.
 */

/dts-v1/;

#include <espressif/esp32p4/esp32p4_rev3.dtsi>
#include "esp32p4c5_core_board_esp32p4_hpcore-pinctrl.dtsi"
#include <espressif/partitions_0x2000_default_16M.dtsi>
#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-sw.h>

/* Size of the in-package PSRAM; the device and the allocation pool below
 * must agree. */
#define PSRAM_BYTES DT_SIZE_M(32)

/ {
	model = "Osptek ESP32-P4C5 Core Board HP Core";
	compatible = "osptek,esp32p4c5-core-board";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,watchdog = &wdt0;
		zephyr,bt-hci = &esp_hosted_mcu_hci;
	};

	aliases {
		watchdog0 = &wdt0;
	};

	/*
	 * The in-package PSRAM, all of it, is the allocation pool of the C
	 * library's allocator (platform/zephyr/libc_heap.c; owner decision
	 * 2026-11-24). It starts at the base of the mapped PSRAM, where the
	 * linker's ext_dram_seg starts too, so nothing may be placed there at
	 * link time: CONFIG_ESP_SPIRAM_HEAP_SIZE is 0 in the board defconfig and
	 * the shared multi-heap is off (a zero-size window must not be handed to
	 * it). An app that needs static objects in PSRAM shrinks this node.
	 */
	psram_heap: memory@48000000 {
		compatible = "zephyr,memory-region";
		reg = <0x48000000 PSRAM_BYTES>;
		zephyr,memory-region = "PSRAM_HEAP";
		zephyr,memory-attr = <(DT_MEM_CACHEABLE | DT_MEM_SW(ATTR_SW_ALLOC_CACHE))>;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <PSRAM_BYTES>;
};

/* v3.x silicon: valid CPU frequencies are 100/200/400 MHz */
&cpu0 {
	clock-frequency = <DT_FREQ_M(400)>;
};

&cpu1 {
	clock-frequency = <DT_FREQ_M(400)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	/* Dev-board ES8311 codec on this bus (expect 0x18) — I2S0 pad map
	 * pending vendor confirmation (schematic text layer has the I2S0_*
	 * nets but not their GPIO mapping). */
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&dma_axi {
	status = "okay";
};

/*
 * Internal LDO rails. Channel 2 (1.8 V) feeds the stacked PSRAM and its
 * MPLL: ESP-IDF reserves that channel for PSRAM and opens it before the chip
 * is initialized, while the Zephyr port of the same vendor code leaves the
 * rail to the devicetree regulator driver (hal_espressif skips its own
 * acquire when CONFIG_REGULATOR_ESP32 is built). Upstream boards with
 * in-package PSRAM declare it exactly like this (waveshare
 * esp32p4_wifi6_dev_kit, espressif esp32p4x_function_ev_board). Without the
 * declaration the rail stays off and every PSRAM read returns 0x3b3b3b3b.
 * Channel 1 (3.3 V) is the SPI NOR flash rail the ROM already enables.
 *
 * Channels 3 and 4 stay off. The regulator driver enables every child node
 * that is left "okay", so they are disabled explicitly: the carrier routes
 * neither (the module exposes only VO4 on pin 66, unrouted on the carrier
 * schematic V1.5, and VO3 is not exposed at all), and the ROM leaves both
 * off after reset.
 */
&ldo {
	status = "okay";

	ldo1@1 {
		reg = <1>;
		regulator-name = "ldo1";
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo2@2 {
		reg = <2>;
		regulator-name = "ldo2";
		regulator-init-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo3@3 {
		status = "disabled";
	};

	ldo4@4 {
		status = "disabled";
	};
};

&sdhc {
	sdhc0: sdhc@0 {
		status = "okay";
		/* Dev-board TF slot P1 (TF-123-ARP9H17)。P4 SDMMC slot0 无
		 * GPIO matrix（LL：仅 slot1 支持）——sdhc_esp32 走
		 * configure_pin_iomux 对本组焊盘套 SDMMC func0；焊盘**角色**
		 * 由 func0 硬连线决定（CLK=GPIO43=SD1_CCLK、CMD=GPIO44=
		 * SD1_CCMD、D3..D0=GPIO42..39，与核心板 88-pin 焊盘复用表
		 * 一致，2026-11-24 又与底板原理图 V1.5 的 TF_CARD 块逐脚核对：
		 * DATA0=GPIO39/DATA1=GPIO40/DATA2=GPIO41/DATA3=GPIO42、
		 * CMD=GPIO44/CLK=GPIO43，数据与命令线各有 10K 上拉）。
		 * r14 真机对拍：clk/cmd 值互换两轮
		 * sd_init 均 PASS（角色不随属性标签走）、属性全删即
		 * INIT_FAIL(-ENOTSUP=焊盘未使能)——即属性决定"使能哪组焊盘"
		 * （必须正确），clk/cmd 语义标签不路由信号；标签保持与物理
		 * 一致防误读。SD_DET=GPIO45（卡座 SWITCH 脚 9，外部 10K 上拉，
		 * 底板原理图 V1.5 一致）无 binding cd 面——应用层读
		 * （ACTIVE_HIGH：卡在位=1，r14 真机实证：插卡后卡座开关断开、
		 * 物理高电平）。 */
		bus-width = <4>;
		max-bus-freq = <DT_FREQ_M(40)>;
		clk-pin = <43>;
		cmd-pin = <44>;
		d0-pin = <39>;
		d1-pin = <40>;
		d2-pin = <41>;
		d3-pin = <42>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};

	sdhc1: sdhc@1 {
		status = "okay";
		/* ESP32-C5 companion (c5-p4-connection.png): C5 slave firmware
		 * = esp-hosted 3.x (owner-confirmed 2026-10-30, matches the
		 * driver's major-3 contract).
		 * Handshake IO: P4 GPIO6 <-> C5 GPIO2 (not modeled by the
		 * current esp_hosted_mcu binding). */
		bus-width = <4>;
		max-bus-freq = <DT_FREQ_M(40)>;
		clk-pin = <18>;
		cmd-pin = <19>;
		d0-pin = <14>;
		d1-pin = <15>;
		d2-pin = <16>;
		d3-pin = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		esp_hosted_mcu: esp-hosted-mcu@0 {
			compatible = "espressif,esp-hosted-mcu";
			reg = <0>;
			reset-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
			status = "okay";

			esp_hosted_mcu_wifi: wifi {
				compatible = "espressif,esp-hosted-mcu-wifi";
				status = "okay";
			};

			esp_hosted_mcu_hci: bt-hci {
				compatible = "espressif,esp-hosted-mcu-bt-hci";
				status = "okay";
			};
		};
	};
};

&usb_serial {
	status = "disabled";
};

&i2s0 {
	/* Audio face (schematic PDF hi-res render per-pin read, 2026-10-30
	 * final): MCLK=GPIO13, BCLK(SCLK)=GPIO12, WS(LRCK)=GPIO10,
	 * DO(DSDIN, P4 out)=GPIO9, DI(ASDOUT, P4 in)=GPIO11; ES8311 @ i2c0
	 * 0x18 (probed online), NS4150 PA ctrl = GPIO53 (STD), analog MEMS
	 * mic (LMA3729) differential into MIC1P/N. Acoustic loop verified
	 * on-target 2026-10-30 (speaker -> mic, evidence
	 * p4c5_audio_acoustic_loop_20261030.txt) with esp32-gdma PR #123642
	 * applied in the build tree only; held disabled until that fix
	 * lands upstream (or passes a pristine-tree run) - flip to "okay"
	 * then. */
	status = "disabled";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "rx", "tx";
};
